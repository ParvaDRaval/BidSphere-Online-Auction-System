# Copy this file to .env and fill the values before starting the backend
# Example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bidsphere?retryWrites=true&w=majority

MONGO_URI=

# Optional: other env vars used by the project (JWT_SECRET, CLOUDINARY_*, etc.)
# JWT_SECRET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
